# ─────────────────────────────────────────────────────────────
# Kabadiwala — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────

# ── Google OAuth ──────────────────────────────────────────────
# Get your client ID from: https://console.cloud.google.com
# 1. Create a project → APIs & Services → Credentials
# 2. Create OAuth 2.0 Client ID (Web application)
# 3. Add Authorized JavaScript origins:
#    - http://localhost:5173  (dev)
#    - https://yourdomain.vercel.app  (prod)
# 4. Paste the Client ID below (NOT the secret — this is public)
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ── MongoDB ───────────────────────────────────────────────────
# Get from: https://cloud.mongodb.com (MongoDB Atlas is free)
# 1. Create a cluster → Connect → Drivers → copy the URI
# 2. Replace <password> with your DB user password
# 3. Add your Vercel deployment IP to Atlas IP allowlist (or 0.0.0.0/0)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority

# ── MongoDB Database Name (optional, default: kabadiwala) ─────
MONGODB_DB=kabadiwala

# ── Node Environment ──────────────────────────────────────────
NODE_ENV=development
# Gemini API 
VITE_GEMINI_KEY=your-gemini-api-key-here

